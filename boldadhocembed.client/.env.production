# API Configuration for Production (Local Docker Stack)
# Empty value = same-origin relative paths (calls http://localhost:5050/api/...)
VITE_API_BASE_URL=

# Bold Reports Configuration
VITE_BOLD_REPORT_SERVICE_URL=https://demos.boldreports.com/services/api/ReportViewer

# Direct Bold Reports v5 API base for production
VITE_BOLDREPORTS_API_BASE=https://cloud.boldreports.com/reporting/api/site/site1/v5.0

# Application Configuration
VITE_APP_NAME=Bold Reports Explorer
VITE_APP_VERSION=1.0.0

# Production
VITE_DEBUG=false
