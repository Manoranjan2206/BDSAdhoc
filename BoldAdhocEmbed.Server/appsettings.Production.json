{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BoldReports": {
    "ReportRootUrl": "${BOLD_REPORTS_URL:https://cloud.boldreports.com/reporting}",
    "ReportsSiteIdentifier": "${BOLD_REPORTS_SITE_ID}",
    "AdminUser": "${BOLD_REPORTS_USER}",
    "AdminPassword": "${BOLD_REPORTS_PASSWORD}",
    "EmbedSecret": "${BOLD_REPORTS_EMBED_SECRET}"
  },
  "BoldBI": {
    "ServerUrl": "${BOLD_BI_URL:https://cloud.boldbi.com/bi}",
    "SiteIdentifier": "${BOLD_BI_SITE_ID}",
    "AdminUser": "${BOLD_BI_USER}",
    "AdminPassword": "${BOLD_BI_PASSWORD}",
    "EmbedSecret": "${BOLD_BI_EMBED_SECRET}",
    "UserEmail": "${BOLD_BI_USER_EMAIL}",
    "Environment": "onpremise"
  }
}
