<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Force use of nuget.org to avoid missing local package sources on this machine -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
