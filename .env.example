# =========================================================================
# BDSAdhoc Multi-Container Deployment Environment Configuration
# =========================================================================
# Copy this file to .env and update values for your environment

# =========================================================================
# Container General Settings
# =========================================================================
COMPOSE_PROJECT_NAME=bdsadhoc
COMPOSE_FILE=docker-compose.yml

# =========================================================================
# PostgreSQL Database Configuration
# =========================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Password123!
POSTGRES_DB=boldservices
POSTGRES_DATA_PATH=./.data/postgres

# =========================================================================
# Nginx Configuration
# =========================================================================
NGINX_HOST=localhost
NGINX_PORT=80
# For production, uncomment and set your domain:
# NGINX_HOST=example.com
# NGINX_PORT=443

# =========================================================================
# Bold BI Configuration
# =========================================================================
BOLDBI_DATA_PATH=./.data/boldbi
# Bold BI pointing to cloud service
BoldBI__ServerUrl=https://cloud.boldbi.com/bi
BoldBI__SiteIdentifier=b1159702
BoldBI__AdminUser=manoranjan.rajendran@syncfusion.com
BoldBI__AdminPassword=Admin@123
BoldBI__EmbedSecret=nhXoWeoMdDfCkSFD3AxiriqPLreL9VJe

# =========================================================================
# Bold Reports Configuration
# =========================================================================
BOLDREPORTS_DATA_PATH=./.data/boldreports
# Bold Reports pointing to cloud service
BoldReports__ReportRootUrl=https://cloud.boldreports.com/reporting
BoldReports__ReportsSiteIdentifier=b1159702
BoldReports__AdminUser=manoranjan.rajendran@syncfusion.com
BoldReports__AdminPassword=Admin@123
BoldReports__EmbedSecret=Yhfw5o9c01TVdPk8HWhQQnGKAl0K9HP

# =========================================================================
# Application Configuration
# =========================================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# =========================================================================
# Optional: SSL Certificate Paths (For HTTPS)
# =========================================================================
# SSL_CERTIFICATE_PATH=./ssl/cert.crt
# SSL_CERTIFICATE_KEY_PATH=./ssl/cert.key

# =========================================================================
# Optional: Logging Configuration
# =========================================================================
LOG_LEVEL=info
# Available: debug, info, warn, error

# =========================================================================
# Optional: Performance Tuning
# =========================================================================
# Nginx worker connections
NGINX_WORKER_CONNECTIONS=1024
# Database max connections
POSTGRES_MAX_CONNECTIONS=200
