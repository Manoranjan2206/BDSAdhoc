# =============================================================================
#  BDSAdhoc Production Environment Variables
#  Copy this file to .env.prod and fill in real values.
#  The .env.prod file is gitignored and never committed.
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=postgres
# CHANGE THIS — use a strong random password
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM

# ---- TLS certificate paths (on the host) ----
# Both files MUST already exist and be readable by the nginx container's UID.
TLS_CERT_FULLCHAIN_PATH=/etc/letsencrypt/app.boldreportsdemo.com/fullchain.pem
TLS_CERT_KEY_PATH=/etc/letsencrypt/app.boldreportsdemo.com/privkey.pem

# ---- Bold Reports (cloud) ----
BR_ReportRootUrl=https://adhoc.boldreports.com/reporting
BR_SiteIdentifier=<SITE_ID>
BR_AdminUser=<ADMIN_USER_EMAIL>
BR_AdminPassword=<ADMIN_PASSWORD>
BR_EmbedSecret=<EMBED_SECRET>

# ---- Bold BI (cloud) ----
BBI_ServerUrl=https://adhoc.boldreports.com/bi
BBI_SiteIdentifier=<SITE_ID>
BBI_AdminUser=<ADMIN_USER_EMAIL>
BBI_AdminPassword=<ADMIN_PASSWORD>
BBI_EmbedSecret=<EMBED_SECRET>
BBI_UserEmail=<ADMIN_USER_EMAIL>
BBI_Environment=onpremise
